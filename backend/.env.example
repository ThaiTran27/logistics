# Backend HTTP and MySQL connection.
PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_logistics_v2

# Keep disabled except for local demos. When enabled in development/demo,
# public registration and login lockout limits are bypassed.
NODE_ENV=development
DEMO_MODE=false

# Required. Generate a unique secret for this environment; see README.md.
JWT_SECRET=

# Optional SMTP configuration for sending email.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional OpenAI-compatible chat completion provider.
# Leave CHAT_AI_API_KEY empty to use the built-in Smart Logistics FAQ assistant.
CHAT_AI_API_KEY=
CHAT_AI_BASE_URL=https://api.openai.com/v1
CHAT_AI_MODEL=gpt-4o-mini

# Public chat/tracking rate limits; buckets are in-process and shared by IP/order.
PUBLIC_API_RATE_LIMIT_WINDOW_MS=900000
PUBLIC_CHAT_RATE_LIMIT_IP=20
PUBLIC_CHAT_RATE_LIMIT_ORDER=5
PUBLIC_TRACK_RATE_LIMIT_IP=60
PUBLIC_TRACK_RATE_LIMIT_ORDER=20
PUBLIC_REGISTER_RATE_LIMIT_IP=5
PUBLIC_REGISTER_RATE_LIMIT_EMAIL=3
CHAT_SESSION_TOKEN_TTL_HOURS=24

# OSRM routing service URL.
OSRM_URL=http://localhost:5001

# Optional stable key for encrypting stored webhook signing secrets.
# If omitted, JWT_SECRET is used.
WEBHOOK_ENCRYPTION_KEY=

# Legacy API key for older integrations. Prefer per-Shop API keys.
OPEN_API_KEY=
