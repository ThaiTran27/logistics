# Optional OpenAI-compatible chat completion provider.
# Leave CHAT_AI_API_KEY empty to use the built-in Smart Logistics FAQ assistant.
CHAT_AI_API_KEY=
CHAT_AI_BASE_URL=https://api.openai.com/v1
CHAT_AI_MODEL=gpt-4o-mini

# Keep this value stable across restarts to decrypt stored webhook signing secrets.
WEBHOOK_ENCRYPTION_KEY=

# Keep this signing key stable across restarts for login sessions and QR manifests.
# Generate a unique random value for each environment; never commit the real value.
JWT_SECRET=
